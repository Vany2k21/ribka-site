<!DOCTYPE html>
<html lang="<%= lang === 'ru' ? 'ru' : 'uk' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t(settings.siteName_ua, settings.siteName_ru) %> — <%= t(settings.tagline_ua, settings.tagline_ru) %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/png" href="/uploads/favicon.png" />
</head>
<body class="has-hero">

<%- include('partials/header', { categories }) %>

<main>

  <section class="hero">
    <% if (heroSlides.length === 0) { %>
      <%- include('partials/photo-block', { image: null, slot: heroSlot, alt: 'Банер', cssClass: 'hero-photo' }) %>
    <% } else { %>
      <% heroSlides.forEach(function(s, i) { %>
        <div class="hero-slide <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>">
          <%- include('partials/photo-block', { image: s.image, slot: heroSlot, alt: f(s, 'title'), cssClass: 'hero-photo' }) %>
          <div class="hero-overlay">
            <div class="container">
              <% if (f(s, 'title')) { %><h1><%= f(s, 'title') %></h1><% } %>
              <% if (f(s, 'subtitle')) { %><p><%= f(s, 'subtitle') %></p><% } %>
              <% if (f(s, 'buttonText')) { %><a href="<%= s.buttonLink || '#popular' %>" class="btn btn-primary"><%= f(s, 'buttonText') %></a><% } %>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (heroSlides.length > 1) { %>
        <div class="hero-dots">
          <% heroSlides.forEach(function(s, i) { %>
            <button type="button" class="hero-dot <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>" aria-label="Слайд <%= i + 1 %>"></button>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </section>

    <section id="popular" class="popular-section container">
      <div class="popular-heading">
        <h2><%= t('Популярні категорії', 'Популярные категории') %></h2>
        <a href="/categories" class="btn btn-outline-accent"><%= t('Всі категорії', 'Все категории') %> →</a>
      </div>

      <% if (popularCategories.length === 0) { %>
        <p class="empty-note"><%= t('Категорії незабаром з’являться.', 'Категории скоро появятся.') %></p>
      <% } else { %>
        <div class="category-tiles-grid">
          <% popularCategories.forEach(function(c) { %>
            <%- include('partials/category-tile', { category: c }) %>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section id="bestsellers" class="popular-section container">
      <div class="popular-heading">
        <h2><%= t('Лідери продажів', 'Лидеры продаж') %></h2>
      </div>

      <% if (bestsellerProducts.length === 0) { %>
        <p class="empty-note"><%= t('Товари незабаром з’являться.', 'Товары скоро появятся.') %></p>
      <% } else { %>
        <div class="products-grid">
          <% bestsellerProducts.forEach(function(p) { %>
            <%- include('partials/product-card', { p: p }) %>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section id="about" class="about container">
      <h2><%= t('Про магазин', 'О магазине') %></h2>
      <p><%= t(settings.about_ua, settings.about_ru) %></p>
    </section>

</main>

<%- include('partials/footer', { categories }) %>

<script src="/js/main.js"></script>
</body>
</html>
