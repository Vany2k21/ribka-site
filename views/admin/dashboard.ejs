<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Адмін-панель</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="icon" type="image/png" href="/uploads/logo-fish.png" />
</head>
<body>
  <div class="admin-header">
    <div class="title">Адмін-панель — <%= settings.siteName_ua %></div>
    <div style="display:flex; align-items:center; gap:16px;">
      <a class="site-link" href="/" target="_blank">Переглянути сайт →</a>
      <form method="POST" action="/admin/logout"><button type="submit">Вийти</button></form>
    </div>
  </div>

  <div class="admin-wrap">
    <div class="admin-nav-grid">

      <a class="admin-nav-card" href="/admin/orders">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l8-4 8 4v10l-8 4-8-4V7z"/><path d="M4 7l8 4 8-4"/><path d="M12 11v10"/></svg>
        </span>
        <span class="admin-nav-title">Замовлення</span>
        <span class="admin-nav-count"><%= ordersCount %></span>
      </a>

      <a class="admin-nav-card" href="/admin/products">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12c3-4 8-6 13-4 2 .8 4 2.4 5 4-1 1.6-3 3.2-5 4-5 2-10 0-13-4z"/><circle cx="16.5" cy="10.5" r="0.7" fill="currentColor" stroke="none"/></svg>
        </span>
        <span class="admin-nav-title">Товари</span>
        <span class="admin-nav-count"><%= productsCount %></span>
      </a>

      <a class="admin-nav-card" href="/admin/categories">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
        </span>
        <span class="admin-nav-title">Категорії</span>
        <span class="admin-nav-count"><%= categoriesCount %></span>
      </a>

      <a class="admin-nav-card" href="/admin/leads">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v13H7l-3 3V4z"/></svg>
        </span>
        <span class="admin-nav-title">Заявки на зв'язок</span>
        <span class="admin-nav-count"><%= leadsCount %></span>
      </a>

      <a class="admin-nav-card" href="/admin/promotions">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8-5.1-4.7 6.9-.8L12 2z"/></svg>
        </span>
        <span class="admin-nav-title">Акції</span>
        <span class="admin-nav-count"><%= promotionsCount %></span>
      </a>

      <a class="admin-nav-card" href="/admin/settings">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.34 1.87l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.7 1.7 0 00-1.87-.34 1.7 1.7 0 00-1.04 1.56V21a2 2 0 01-4 0v-.09A1.7 1.7 0 008.96 19.4a1.7 1.7 0 00-1.87.34l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.7 1.7 0 004.6 15a1.7 1.7 0 00-1.56-1.04H3a2 2 0 010-4h.09A1.7 1.7 0 004.6 8.96a1.7 1.7 0 00-.34-1.87l-.06-.06a2 2 0 112.83-2.83l.06.06A1.7 1.7 0 008.96 4.6a1.7 1.7 0 001.04-1.56V3a2 2 0 014 0v.09a1.7 1.7 0 001.04 1.56 1.7 1.7 0 001.87-.34l.06-.06a2 2 0 112.83 2.83l-.06.06A1.7 1.7 0 0019.4 8.96a1.7 1.7 0 001.56 1.04H21a2 2 0 010 4h-.09a1.7 1.7 0 00-1.56 1.04z"/></svg>
        </span>
        <span class="admin-nav-title">Налаштування сайту</span>
      </a>

      <a class="admin-nav-card" href="/admin/photo-slots">
        <span class="admin-nav-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </span>
        <span class="admin-nav-title">Фото-блоки</span>
      </a>

    </div>
  </div>
</body>
</html>
