<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= product ? 'Редагування товару' : 'Новий товар' %></title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="icon" type="image/png" href="/uploads/favicon.png" />
</head>
<body>
  <div class="admin-header">
    <div class="title"><%= product ? 'Редагування товару' : 'Новий товар' %></div>
    <a class="site-link" href="/admin/products">← Назад до товарів</a>
  </div>
  <div class="admin-wrap">
    <div class="admin-section">
      <form method="POST" action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="field full">
            <label>Категорія</label>
            <select name="categoryId" required>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= product && product.categoryId === c.id ? 'selected' : '' %>><%= c.depth ? '— ' : '' %><%= c.name_ua %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label>Назва (UA)</label><input type="text" name="name_ua" value="<%= product ? product.name_ua : '' %>" required /></div>
          <div class="field"><label>Назва (RU)</label><input type="text" name="name_ru" value="<%= product ? product.name_ru : '' %>" required /></div>
          <div class="field full"><label>Опис (UA)</label><textarea name="desc_ua"><%= product ? product.desc_ua : '' %></textarea></div>
          <div class="field full"><label>Опис (RU)</label><textarea name="desc_ru"><%= product ? product.desc_ru : '' %></textarea></div>
          <div class="field"><label>Ціна</label><input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required /></div>
          <div class="field"><label>Стара ціна (якщо знижка)</label><input type="number" step="0.01" name="oldPrice" value="<%= product && product.oldPrice ? product.oldPrice : '' %>" /></div>
          <div class="field"><label>Одиниця (UA)</label><input type="text" name="unit_ua" value="<%= product ? product.unit_ua : 'грн/кг' %>" /></div>
          <div class="field"><label>Одиниця (RU)</label><input type="text" name="unit_ru" value="<%= product ? product.unit_ru : 'грн/кг' %>" /></div>
          <div class="field">
            <label>Тип одиниці (для лічильника кількості на сайті)</label>
            <select name="unitType">
              <option value="kg" <%= (!product || product.unitType !== 'pcs') ? 'selected' : '' %>>КГ (вага)</option>
              <option value="pcs" <%= (product && product.unitType === 'pcs') ? 'selected' : '' %>>ШТ (штучний товар)</option>
            </select>
            <p class="hint">КГ — покупець обирає кількість кілограмів. ШТ — кількість штук/банок.</p>
          </div>
          <div class="field">
            <label>Кількість замовлень (впливає на популярність категорії)</label>
            <input type="number" min="0" name="orderCount" value="<%= product ? (product.orderCount || 0) : 0 %>" />
          </div>
          <div class="field full">
            <label>Головне фото товару</label>
            <% if (product && product.image) { %><img class="thumb" src="<%= product.image %>" style="margin-bottom:8px" /><% } %>
            <input type="file" name="image" accept="image/*" />
          </div>
          <div class="field full">
            <label>Додаткові фото (галерея на сторінці товару)</label>
            <% if (product && product.images && product.images.length) { %>
              <div class="gallery-thumbs">
                <% product.images.forEach(function(img, i) { %>
                  <div class="gallery-thumb-item">
                    <img class="thumb" src="<%= img %>" />
                    <button
                      type="submit"
                      class="btn btn-danger gallery-thumb-delete"
                      formaction="/admin/products/<%= product.id %>/gallery/<%= i %>/delete"
                      formmethod="POST"
                      formnovalidate
                      onclick="return confirm('Видалити це фото?');"
                    >✕</button>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <input type="file" name="galleryImages" accept="image/*" multiple />
            <p class="hint">Можна вибрати кілька файлів одразу. Нові фото додаються до вже завантажених.</p>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Зберегти</button>
          <a class="btn btn-ghost" href="/admin/products">Скасувати</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
